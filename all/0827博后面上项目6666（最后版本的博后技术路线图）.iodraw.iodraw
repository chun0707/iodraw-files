        <mxCell id="hLanTZSCV7-hm6pJfAgh-37" value="&lt;ul style=&quot;line-height: 160%;&quot;&gt;&lt;li&gt;异常事件为风险更新节点&lt;/li&gt;&lt;li&gt;动态判断个体疾病风险状态&lt;/li&gt;&lt;li&gt;现行筛查指南映射服务需求&lt;/li&gt;&lt;li&gt;推荐时间窗口、服务频率等&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;align=left;" parent="hLanTZSCV7-hm6pJfAgh-1" vertex="1">
